@startuml
actor Покупатель
participant "Сервис заказов" as Order
participant "Сервис каталога" as Catalog
participant "Сервис платежей" as Payment
participant "Сервис уведомлений" as Notify

Покупатель -> Order : Оформление заказа()
Order -> Order : Создание заказа
Order -> Catalog : OrderCreated
Catalog -> Catalog : Резервирование товаров
Catalog --> Order : ItemsReserved
Order -> Payment : PaymentRequested
Payment -> Payment : Ошибка списания
Payment --> Order : PaymentFailed
Order -> Catalog : ItemsReservationCanceled
Catalog -> Catalog : Снятие резерва
Order -> Order : Статус "Отменён"
Order --> Notify : OrderCancelled
Notify --> Покупатель : Уведомление об ошибке
@enduml